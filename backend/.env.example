# ---------------------------------------------------------------------------
# StyleSphere Nexus API - environment contract (spec §16)
# Copy to `.env` for local development. Never commit `.env`.
# On Railway these are set as service variables on BOTH services.
# ---------------------------------------------------------------------------

# --- Supabase ---
# The service-role key bypasses RLS and must never reach the browser.
# The frontend only ever needs NEXT_PUBLIC_API_BASE_URL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SCHEMA=public

# --- Gemini (spec §6) ---
# Dev-only comma-separated bootstrap list. Production keys live encrypted in
# the `gemini_api_keys` table and are never read from the environment.
GEMINI_API_KEYS_SEED=
# Required to encrypt/decrypt stored Gemini keys at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_ENCRYPTION_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EXTRACTION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_MAX_KEY_RETRIES=2

# --- Auth (spec §15) ---
JWT_SECRET=
SUPABASE_JWT_AUD=authenticated

# --- App ---
APP_NAME="StyleSphere Nexus API"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Railway injects PORT at runtime; do not hardcode it in production.
HOST=0.0.0.0
PORT=8000

# --- CORS (spec §19) ---
# The deployed Vercel origin in production.
FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated additional origins (e.g. preview deployments).
EXTRA_CORS_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# --- Logging (spec §17) ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                  # json | console

# --- RAG (spec §7) ---
RAG_CHUNK_TOKENS=650
RAG_CHUNK_OVERLAP_RATIO=0.10
RAG_TOP_K=6
RAG_EMBEDDING_DIMENSIONS=768
